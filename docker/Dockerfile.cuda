ARG STACK_IMAGE=dgx-development:local
ARG CUDA_BUILD_IMAGE=nvidia/cuda:13.0.0-devel-ubuntu22.04@sha256:1470d2d7904fac4e5cb3bdfd4993305c46d3ee76deb0213eaaf248e5cf9c7400

FROM ${CUDA_BUILD_IMAGE} AS cuda-builder
ARG TARGETARCH
ARG CUDA_ARCH=sm_86
ARG CARGO_BUILD_JOBS=2
ARG CUDA_OXIDE_REV=b9847e9515ed3a23096f22567d3eaf0a6e3e440c
ARG RUST_TOOLCHAIN=nightly-2026-08-28
ARG RUSTUP_VERSION=1.28.2
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_TOOLKIT_PATH=/usr/local/cuda \
    CUDA_OXIDE_LLC=/usr/bin/llc-22 \
    LIBCLANG_PATH=/usr/lib/llvm-22/lib \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:/usr/lib/llvm-22/bin:/usr/local/cuda/bin:${PATH}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN test "${TARGETARCH}" = amd64 || { printf '%s\n' 'The optional native CUDA image currently requires linux/amd64; use the ordinary stack image on ARM.' >&2; exit 1; }
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git gnupg build-essential cmake m4 pkg-config xz-utils \
    && curl --proto '=https' --tlsv1.2 -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
       | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && printf '%s\n' 'deb [signed-by=/usr/share/keyrings/llvm.gpg] https://apt.llvm.org/jammy/ llvm-toolchain-jammy-22 main' \
       > /etc/apt/sources.list.d/llvm.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends clang-22 libclang-22-dev llvm-22 \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -fsSL \
       "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
       -o /tmp/rustup-init \
    && curl --proto '=https' --tlsv1.2 -fsSL \
       "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init.sha256" \
       -o /tmp/rustup-init.sha256 \
    && printf '%s  /tmp/rustup-init\n' "$(cut -d ' ' -f 1 /tmp/rustup-init.sha256)" | sha256sum --check \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
       --component rust-src --component rustc-dev --component llvm-tools \
    && rm /tmp/rustup-init /tmp/rustup-init.sha256
RUN cargo +"${RUST_TOOLCHAIN}" install --locked \
    --git https://github.com/NVlabs/cuda-oxide.git --rev "${CUDA_OXIDE_REV}" cargo-oxide
WORKDIR /build
COPY . .
WORKDIR /build/plotter/cuda
RUN test "$(rustup show active-toolchain | cut -d ' ' -f 1)" = "${RUST_TOOLCHAIN}-x86_64-unknown-linux-gnu" \
    && cargo oxide build --arch "${CUDA_ARCH}" -- --locked --release

FROM ${STACK_IMAGE}
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_REQUIRE_CUDA=cuda>=13.0
COPY --from=cuda-builder /build/plotter/cuda/target/release/dg_xch_plotter_cuda /usr/local/bin/dg_xch_plotter_cuda
