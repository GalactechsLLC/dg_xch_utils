{
  "title": "dg-xch — Sync Overview",
  "uid": "dgxch-sync-overview",
  "tags": ["dg-xch"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [
    { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus" }
  ]},
  "panels": [
    { "type": "timeseries", "title": "Blocks per minute (confirmed)", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 12}}, "overrides": []},
      "targets": [
        { "expr": "rate(fullnode_blocks_confirmed_total{job=~\"dg-xch-node.*\"}[5m]) * 60", "legendFormat": "{{job}}" }
      ]},
    { "type": "timeseries", "title": "Peak height by node", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        { "expr": "fullnode_peak_height{job=~\"dg-xch-node.*\"}", "legendFormat": "{{job}} peak" },
        { "expr": "fullnode_claimed_peak_height{job=~\"dg-xch-node.*\"}", "legendFormat": "{{job}} network tip" }
      ]},
    { "type": "timeseries", "title": "Distance to network tip", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        { "expr": "fullnode_claimed_peak_height{job=~\"dg-xch-node.*\"} - fullnode_peak_height{job=~\"dg-xch-node.*\"}", "legendFormat": "{{job}}" }
      ]},
    { "type": "timeseries", "title": "Resident memory", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        { "expr": "fullnode_process_resident_bytes{job=~\"dg-xch-node.*\"}", "legendFormat": "{{job}}" }
      ]},
    { "type": "timeseries", "title": "Peers (outbound solid / inbound dashed)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        { "expr": "fullnode_outbound_peers{job=~\"dg-xch-node.*\"}", "legendFormat": "{{job}} out" },
        { "expr": "fullnode_inbound_peers{job=~\"dg-xch-node.*\"}", "legendFormat": "{{job}} in" }
      ]},
    { "type": "timeseries", "title": "Blocks downloaded vs confirmed (rate/s)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        { "expr": "rate(fullnode_blocks_downloaded_total{job=~\"dg-xch-node.*\"}[5m])", "legendFormat": "{{job}} downloaded" },
        { "expr": "rate(fullnode_blocks_confirmed_total{job=~\"dg-xch-node.*\"}[5m])", "legendFormat": "{{job}} confirmed" }
      ]},
    { "type": "timeseries", "title": "Reclaimed reservations (stalled peers, rate/min)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        { "expr": "rate(fullnode_reservations_reclaimed_total{job=~\"dg-xch-node.*\"}[5m]) * 60", "legendFormat": "{{job}}" }
      ]}
  ]
}
